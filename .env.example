# Postgres 17. Local dev uses a local `keep_dev` database.
DATABASE_URL=postgres://localhost/keep_dev
# The Clerk application shared with Balance, so one sign-in works across both.
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
VITE_CLERK_PUBLISHABLE_KEY=
# People, where people live: local People (`bun run dev` there) or https://people.example.com in production,
# and Keep's service key there (`bun run key:mint --service keep` in People). The browser only links to People, at
# VITE_PEOPLE_URL; its data comes through Keep's backend.
PEOPLE_URL=http://localhost:3250
PEOPLE_API_KEY=
# Where notifications go, when not to PEOPLE_URL: a local Keep pointed at production People sets it to local People so
# its outbox sends no real emails.
PEOPLE_NOTIFY_URL=
# Pai's People person id (`bun run pai:seed` in People): needed by `bun run db:migrate` while agents exist (they become
# Pai) and by `bun run pai:key`.
PAI_PEOPLE_ID=
VITE_PEOPLE_URL=http://localhost:3250
# Where the app opens, for the links notifications carry (https://keep.example.com in production); the local
# frontend (http://localhost:5240) when unset.
KEEP_URL=
AI_GATEWAY_API_KEY=

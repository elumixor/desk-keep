{
  "name": "@desk/keep",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "devkit dev:web",
    "build": "devkit build",
    "build:web": "bun run db:migrate && devkit build:web",
    "generate": "cd apps/backend && bunx nitro-client",
    "check": "bun run --filter '*' check",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "db:migrate": "bun run --cwd apps/backend db:migrate",
    "import:notion": "bun run --cwd apps/backend scripts/import-notion.ts",
    "pai:key": "bun run --cwd apps/backend scripts/pai-key.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.6",
    "@elumixor/devkit": "^0.12.7",
    "@types/bun": "latest",
    "postgres": "^3.4.9",
    "typescript": "^6.0.3"
  },
  "devkit": {
    "generate": {
      "command": "bunx nitro-client",
      "cwd": "apps/backend"
    },
    "dev": {
      "web": {
        "processes": {
          "backend": {
            "filter": "@keep/backend",
            "port": 3240,
            "color": "blue"
          },
          "frontend": {
            "filter": "@keep/frontend",
            "port": 5240,
            "color": "magenta",
            "open": true
          }
        }
      }
    },
    "build": {
      "web": {
        "type": "web",
        "options": {
          "frontendDir": "apps/frontend",
          "backendDir": "apps/backend",
          "apiPrefixes": [
            "api",
            "mcp",
            "health",
            ".well-known"
          ]
        }
      }
    }
  }
}

{
  "compilerOptions": {
    "target": "ESNext",
    "lib": ["esnext", "dom"],
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "types": ["bun"]
  },
  "include": ["scripts/**/*.ts"],
  "exclude": ["node_modules", "apps"]
}
